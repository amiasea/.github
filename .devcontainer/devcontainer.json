{
  "name": "Amiasea Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {}
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "Amiasea/powershell": {
          "permissions": {
            "packages": "read"
          }
        }
      }
    }
  },
  "postCreateCommand": {
    "install-proxies": "pwsh -NoProfile -Command \"Install-PSResource Amiasea.Proxies -Scope CurrentUser -TrustRepository; Import-Module Amiasea.Proxies\""
  }
}