{
  "name": "Amiasea Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/powershell:1": {}
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "Amiasea/powershell": {
          "permissions": {
            "packages": "read"
          }
        }
      }
    }
  },
  "postCreateCommand": {
    "setup-powershell": "pwsh -NoProfile -File .devcontainer/setup.ps1"
  }
}


