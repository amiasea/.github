store "varset" "amiasea" {
  name     = "amiasea"
  category = "terraform"
}

upstream_input "module_catalog_identification" {
  type   = "stack"
  source = "app.terraform.io/${tfe_organization}/${tfe_project_name}/deployment-catalog-identification-module-catalog"
}

upstream_input "stack_catalog_identification" {
  type   = "stack"
  source = "app.terraform.io/${tfe_organization}/${tfe_project_name}/deployment-catalog-identification-stack-catalog"
}

deployment "default" {
  inputs = {
    tfe_organization = "${tfe_organization}"
    tfe_token        = store.varset.amiasea.tfe_token
    module_catalog   = upstream_input.module_catalog_identification.modules
    stack_catalog    = upstream_input.stack_catalog_identification.stacks
  }
}
